# keiro-dsl language version preamble — a source may open by naming the released language
# contract it was written against. The preamble is allowed to sit below a comment banner like
# this one, which is why this file has one: the parser strips comments and blank lines before
# deciding which line is first. Every word named in this comment — language, keiro-dsl,
# context, module, aggregate — must stay Comment, not keyword.

language keiro-dsl 1
context journal-service
module Acme.Services
layout prefixed

aggregate Journal
  regs
    revision Natural = 0
    caption  Text    = placeholder
  states Empty Recorded!

  # `language` is not a reserved word, so it is still legal as a field name — but only in the
  # middle of a line. The parser asks whether a line's FIRST word is `language`, so a register
  # declared on its own line as `language Text = "en"` would be read as a misplaced preamble
  # and rejected. A highlighter has no such rule: it colours every `language` as a keyword.
  command Write { revision:Natural caption:Text language:Text }
  event   Written { revision:Natural caption:Text }

  Empty -- Write -->
    guard revision >= revision
    write revision := revision
    write caption := caption
    emit  Written
    goto  Recorded

  wire kind=ctorName fields=camelCase schemaVersion=1
